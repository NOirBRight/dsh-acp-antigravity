+_MAX_SAFE_INTEGER = 2**53 - 1
+
+
+def _is_usage_count(value):
+  """True for a real counter: an integer, zero or more, never boolean,
+  within 2**53 - 1 so it survives JSON/JS number handling losslessly."""
+  return (
+      isinstance(value, int)
+      and not isinstance(value, bool)
+      and 0 <= value <= _MAX_SAFE_INTEGER
+  )
+
+
+def _usage_field(usage, name):
+  if usage is None:
+    return None
+  try:
+    return getattr(usage, name)
+  except Exception:
+    return None
+
+
+def _count_delta(end, start, new_epoch):
+  """Turn delta for one counter. Missing fields stay missing; they are never zero-filled."""
+  if end is None:
+    return None
+  if not _is_usage_count(end):
+    return None
+  if start is None:
+    return end if new_epoch else None
+  if not _is_usage_count(start):
+    return None
+  delta = end - start
+  return delta if _is_usage_count(delta) else None
+
+
+def _cumulative_usage(agent):
+  try:
+    return agent.conversation.total_usage
+  except Exception:
+    return None
+
+
+def _usage_snapshot(usage):
+  """Raw SDK counters before subtraction; absent fields stay null."""
+  if usage is None:
+    return None
+  return {name: _usage_field(usage, name) for name in (
+      "prompt_token_count", "candidates_token_count", "thoughts_token_count",
+      "total_token_count", "cached_content_token_count")}
+
+
+def _prompt_token_usage(end, start=None, new_epoch=False):
+  """Builds schema.Usage from cumulative SDK snapshots, or None when unusable.
+
+  Uses the module-global schema import. Mapping (ACP UNSTABLE Usage):
+  SDK prompt_token_count and total_token_count exclude cache. ACP
+  inputTokens and totalTokens add the cached_content_token_count delta
+  so the existing adapter can subtract cachedReadTokens. outputTokens
+  takes the candidates_token_count delta ONLY; thinking tokens ride
+  thoughtTokens. The cache counter is required to form that aggregate;
+  a missing cache field cannot be treated as zero. Only a session
+  created by new_session has a known zero baseline before its first
+  attempt. Restored or retried sessions require explicit baseline
+  counters. Zeros the backend explicitly reported stay zeros. Rewinding
+  counters yield None (absent), never a fake zero. Cache may exceed
+  uncached prompt.
+  """
+  if end is None:
+    return None
+  prompt = _count_delta(_usage_field(end, "prompt_token_count"), _usage_field(start, "prompt_token_count"), new_epoch)
+  candidates = _count_delta(_usage_field(end, "candidates_token_count"), _usage_field(start, "candidates_token_count"), new_epoch)
+  total = _count_delta(_usage_field(end, "total_token_count"), _usage_field(start, "total_token_count"), new_epoch)
+  thoughts = _count_delta(_usage_field(end, "thoughts_token_count"), _usage_field(start, "thoughts_token_count"), new_epoch)
+  end_cached = _usage_field(end, "cached_content_token_count")
+  start_cached = _usage_field(start, "cached_content_token_count")
+  if end_cached is not None and not _is_usage_count(end_cached):
+    return None
+  if start_cached is not None and not _is_usage_count(start_cached):
+    return None
+  if end_cached is not None and start_cached is not None and end_cached < start_cached:
+    return None
+  cached = _count_delta(end_cached, start_cached, new_epoch)
+  if prompt is None or candidates is None or total is None or cached is None:
+    return None
+  if thoughts is None:
+    if total != prompt + candidates:
+      return None
+  elif total != prompt + candidates + thoughts:
+    return None
+  input_tokens = prompt + cached
+  total_tokens = total + cached
+  if not _is_usage_count(input_tokens) or not _is_usage_count(total_tokens):
+    return None
+  kwargs = {
+      "input_tokens": input_tokens,
+      "output_tokens": candidates,
+      "total_tokens": total_tokens,
+      "cached_read_tokens": cached,
+  }
+  if thoughts is not None:
+    kwargs["thought_tokens"] = thoughts
+  try:
+    return schema.Usage(**kwargs)
+  except Exception:
+    return None
+
