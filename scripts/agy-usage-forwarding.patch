#
# Target (pinned, verified byte-identical in archive and extraction):
#   agy_acp_server_20260818_01_RC01
#   google3/cloud/developer_experience/antigravity_extensions/acp_server/server.py
# Applies ONLY to the final prompt() return path. Early returns (logout,
# cancelled, errors) intentionally omit partial telemetry: counters may be
# incomplete there, and partial usage is never forwarded.
# Archive builds must regenerate matching checked-hash Python 3.14 bytecode
# alongside server.py and verify loading with the native executable.
--- server.py
