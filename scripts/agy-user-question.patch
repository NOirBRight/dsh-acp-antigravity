# OPT-IN patch: ACP question freeform via flat _meta, not permission option IDs.
#
# Target (pinned): agy_acp_server_20260818_01_RC01
#   google3/cloud/developer_experience/antigravity_extensions/acp_server/server.py
#   google3/cloud/developer_experience/antigravity_extensions/acp_server/hooks.py
# Question requests (dummy interaction_ toolCallId) advertise
# _meta["agy.supportsFreeform"]=true. A freeform Other answer is
# outcome cancelled plus _meta["agy.freeformResponse"]=text: no fabricated
# optionId. Native reads that metadata before the cancelled branch and
# returns google.antigravity.types.QuestionResponse (selected_option_ids
# for a real choice, freeform_response for Other, None for genuine
# cancel). Ordinary session/request_permission tool prompts are unchanged.
# hooks.py must change: the same ask callback serves questions and
# workspace-trust, and ExternalOnInteractionHook previously wrapped a
# string into selected_option_ids only. Archive builds must regenerate
# matching checked-hash Python 3.14 bytecode for both files as
# build-agy-usage-runtime.py describes.
--- server.py
+++ server.py
@@ -3944,7 +3944,7 @@
       )
     async def ask_user_callback(
         title: str, options: Sequence[sdk_types_module.AskQuestionOption]
-    ) -> str | None:
+    ) -> sdk_types_module.QuestionResponse | None:
       return await self._ask_user_handler(
           session_id=session_id, title=title, options=options
       )
@@ -4588,13 +4588,27 @@
           exc_info=True,
       )
 
+  def _agy_question_freeform(self, response):
+    """Read _meta['agy.freeformResponse'] before any cancelled-outcome branch."""
+    meta = getattr(response, "field_meta", None)
+    if meta is None:
+      return None
+    if not isinstance(meta, dict):
+      raise ValueError("Antigravity question metadata is malformed")
+    if "agy.freeformResponse" not in meta:
+      return None
+    value = meta["agy.freeformResponse"]
+    if not isinstance(value, str):
+      raise ValueError("Antigravity question freeform metadata is malformed")
+    return value
+
   async def _ask_user_handler(
       self,
       *,
       session_id: str,
       title: str,
