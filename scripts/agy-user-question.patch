     """Prompt the user with a question and multiple choice options.
 
     Args:
@@ -4603,7 +4617,8 @@
       options: A sequence of options presented to the user.
 
     Returns:
-      The selected option ID, or None if the interaction was cancelled.
+      A QuestionResponse with selected option IDs or freeform text, or
+      None if the interaction was cancelled.
     """
     if not self._client:
       return None
@@ -4646,13 +4661,14 @@
             raw_input={},
             status="pending",
         ),
+        **{"agy.supportsFreeform": True},
     )
 
-    status = (
-        "completed"
-        if isinstance(response.outcome, schema.AllowedOutcome)
-        else "failed"
+    freeform = self._agy_question_freeform(response)
+    answered = freeform is not None or isinstance(
+        response.outcome, schema.AllowedOutcome
     )
+    status = "completed" if answered else "failed"
     await self._client.session_update(
         session_id=session_id,
         update=schema.ToolCallProgress(
@@ -4667,10 +4683,12 @@
         ),
     )
 
+    if freeform is not None:
+      return sdk_types_module.QuestionResponse(freeform_response=freeform)
     if isinstance(response.outcome, schema.AllowedOutcome):
-      return response.outcome.option_id
-    elif isinstance(response.outcome, schema.DeniedOutcome):
-      return getattr(response.outcome, "option_id", None)
+      return sdk_types_module.QuestionResponse(
+          selected_option_ids=[response.outcome.option_id]
+      )
     return None
 
   async def prompt(  # pyrefly: ignore[bad-override]
