{
  "name": "@deepseek-ai/dsh-acp-antigravity",
  "version": "0.1.0",
  "description": "Google Antigravity ACP provider for DeepSeek Harness",
  "repository": { "type": "git", "url": "https://github.com/NOirBRight/dsh-acp-antigravity.git" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./settings": { "types": "./dist/settings.d.ts", "default": "./dist/settings.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "docs/notes", "LICENSE"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-acp-provider": ">=0.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-acp-provider": "file:../dsh-acp-provider",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
